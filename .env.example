# ===== Bro Barber — Environment =====

# --- Database (MongoDB) ---
# WAJIB: server harus replica set (docker compose sudah pakai --replSet rs0
# dan diinisialisasi lewat rs.initiate() — lihat README).
# Tidak perlu parameter replicaSet di URI: driver menemukan sendiri lewat hello.
MONGODB_URI=mongodb://localhost:27017/bro-barber

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-please-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Opsional: daftar host diizinkan (dipisah koma) utk proteksi host-header,
# selain host dari BETTER_AUTH_URL & localhost. Contoh: mydomain.com,www.mydomain.com
BETTER_AUTH_ALLOWED_HOSTS=

# --- Payment (selalu simulasi) ---
# Provider aktif dikunci ke simulasi di src/lib/payment/index.ts.
# PAYMENT_PROVIDER disimpan untuk referensi/pengembangan integrasi Xendit.
PAYMENT_PROVIDER=simulation

# Token untuk mengautentikasi webhook (dipakai simulation & xendit)
PAYMENT_WEBHOOK_TOKEN=brobarber-sim-webhook-token

# --- Xendit (khusus mode "xendit") ---
XENDIT_SECRET_KEY=
# Harus sama dengan "Webhook verification token" di dashboard Xendit
XENDIT_WEBHOOK_TOKEN=
# Opsional: override base URL API (default https://api.xendit.co)
XENDIT_URL=

# --- Object storage (upload gambar) ---
# Mode: "s3" (RustFS/MinIO, lokal — default) | "cloudinary" (produksi)
# WAJIB diset di produksi agar upload gambar tidak 501.
STORAGE_PROVIDER=s3

# --- S3-compatible (RustFS lokal / MinIO / AWS S3) ---
# Default untuk docker compose lokal (rustfs).
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=brobarber
S3_SECRET_KEY=brobarber123
S3_BUCKET=bro-barber
S3_REGION=us-east-1
# URL dasar untuk render <Image> di browser — BUKAN endpoint API internal.
S3_PUBLIC_URL=http://localhost:9000/bro-barber
# Port console web (untuk login manual di browser)
S3_CONSOLE_PORT=9001

# --- Cloudinary (hanya bila STORAGE_PROVIDER=cloudinary) ---
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Admin seed (password awal, ubah setelah login pertama) ---
SEED_ADMIN_EMAIL=admin@brobarber.id
SEED_ADMIN_PASSWORD=BroBarber123!
SEED_CASHIER_EMAIL=kasir@brobarber.id
SEED_CASHIER_PASSWORD=BroBarber123!
