# ===== Bro Barber — Environment =====

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017/bro-barber

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-please-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# --- Payment (Simulation mode by default) ---
# Mode: "simulation" | "xendit"
PAYMENT_PROVIDER=simulation

# Token untuk mengautentikasi webhook (dipakai simulation & xendit)
PAYMENT_WEBHOOK_TOKEN=brobarber-sim-webhook-token

# --- Xendit (khusus mode "xendit" — diisi saat beralih dari simulasi) ---
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- Upload gambar (mode lokal; public/uploads) ---
# Local dir digunakan selama belum ada Cloudinary
UPLOAD_DIR=public/uploads

# --- Admin seed (password awal, ubah setelah login pertama) ---
SEED_ADMIN_EMAIL=admin@brobarber.id
SEED_ADMIN_PASSWORD=BroBarber123!
SEED_CASHIER_EMAIL=kasir@brobarber.id
SEED_CASHIER_PASSWORD=BroBarber123!
